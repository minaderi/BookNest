@{
    // Admin sayfalarının üstündeki sekmeler. Açık olan sayfanın sekmesi yeşil görünür.
    var aktif = ViewContext.RouteData.Values["page"]?.ToString();
    var sekmeler = new (string Sayfa, string Ad)[]
    {
        ("/Admin/Books", "Books"),
        ("/Admin/Reviews", "Reviews")
    };
}

<style>
    .admin-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; }
    .admin-nav a {
        border: 1px solid var(--line);
        background: #fff;
        color: var(--brown-dark);
        border-radius: 999px;
        padding: .3rem 1rem;
        font-size: .9rem;
        text-decoration: none;
    }
    .admin-nav a:hover { border-color: var(--green); color: var(--brown-dark); }
    .admin-nav a.on { background: var(--brown-dark); border-color: var(--brown-dark); color: #fff; font-weight: 600; }
</style>

<nav class="admin-nav">
    @foreach (var s in sekmeler)
    {
        <a href="@s.Sayfa" class="@(aktif == s.Sayfa ? "on" : "")">@s.Ad</a>
    }
</nav>