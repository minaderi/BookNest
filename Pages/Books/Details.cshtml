@page "/Books/Details/{id:int}"
@model BookNest.Pages.Books.DetailsModel
@using BookNest.Models

@{
    ViewData["Title"] = Model.Book.Title;
    var pct = (Model.AverageRating / 5 * 100)
        .ToString("0", System.Globalization.CultureInfo.InvariantCulture);
}

<style>
    .details-page {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem 0 3rem;
    }

    .details-breadcrumb { font-size: .88rem; margin-bottom: 1.5rem; }
    .details-breadcrumb a { color: var(--green); text-decoration: none; }
    .details-breadcrumb a:hover { text-decoration: underline; }

    .details-cover {
        width: 100%;
        max-width: 260px;
        border-radius: var(--radius);
        box-shadow: 0 6px 18px rgba(56, 33, 16, .25);
    }

    .details-cover-empty {
        width: 100%;
        max-width: 260px;
        aspect-ratio: 2 / 3;
        border-radius: var(--radius);
        background: #fff;
        border: 1px dashed var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-size: 1rem;
    }

    .details-title {
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: 2.3rem;
        color: var(--brown-dark);
        line-height: 1.2;
        margin-bottom: .4rem;
    }

    .details-author {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        color: var(--text);
        margin-bottom: 1rem;
    }

    .details-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem; }

    .details-tag {
        background: #fff;
        border: 1px solid var(--line);
        color: var(--brown-dark);
        border-radius: 999px;
        padding: .2rem .85rem;
        font-size: .85rem;
    }

    .details-section-title {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--brown-dark);
        border-bottom: 1px solid var(--line);
        padding-bottom: .4rem;
        margin: 1.5rem 0 .9rem;
    }

    .details-desc {
        font-family: var(--font-serif);
        font-size: 1.05rem;
        line-height: 1.75;
        color: var(--text);
        white-space: pre-line;
    }

    .details-back {
        display: inline-block;
        margin-top: 1.5rem;
        background: transparent; border: 1px solid var(--brown-dark);
        color: var(--brown-dark);
        border-radius: var(--radius);
        padding: .5rem 1.4rem;
        text-decoration: none;
        font-size: .92rem;
    }
    .details-back:hover { background: var(--brown-dark); color: #fff; }

    /* Puan alanı */
    .rating-box { margin-top: 1.25rem; max-width: 260px; text-align: left; }
    .rating-avg { display: flex; align-items: center; gap: .6rem; }

    .rating-avg .num {
        font-family: var(--font-serif);
        font-size: 1.9rem;
        font-weight: 700;
        color: var(--brown-dark);
        line-height: 1;
    }

    .rating-summary { font-size: .85rem; color: var(--muted); margin-top: .25rem; }

    .star { width: 24px; height: 24px; flex: 0 0 24px; fill: currentColor; }

    .stars-static { position: relative; display: inline-flex; color: var(--star-off); }

    .stars-static .fill {
        position: absolute;
        left: 0;
        top: 0;
        display: flex;
        overflow: hidden;
        color: var(--star);
    }

    .rate-title {
        font-size: .85rem;
        color: var(--soft);
        margin: 1.1rem 0 .3rem;
        padding-top: .9rem;
        border-top: 1px solid var(--line);
    }

    .star-input { display: inline-flex; flex-direction: row-reverse; }

    .star-input button {
        background: none;
        border: 0;
        padding: 0 1px;
        color: var(--star-off);
        cursor: pointer;
    }

    .star-input button .star { width: 30px; height: 30px; }
    .star-input button.on { color: var(--star); }
    .star-input:hover button { color: var(--star-off); }
    .star-input button:hover,
    .star-input button:hover ~ button { color: var(--star); }

    .rate-login { font-size: .88rem; color: var(--green); }

    /* Raf ve favori alanı */
    .shelf-box { margin-top: 1.25rem; max-width: 260px; text-align: left; }
    .shelf-buttons { display: flex; flex-direction: column; gap: .4rem; }

    .shelf-btn {
        width: 100%;
        text-align: left;
        background: #fff;
        border: 1px solid var(--line);
        color: var(--brown-dark);
        border-radius: var(--radius);
        padding: .45rem .8rem;
        font-size: .92rem;
        cursor: pointer;
    }
    .shelf-btn:hover { border-color: var(--green); }
    .shelf-btn.on { background: var(--action); border-color: var(--action); color: #fff; font-weight: 600; }

    .shelf-remove {
        background: none;
        border: 0;
        padding: .2rem 0;
        color: var(--muted);
        font-size: .82rem;
        text-decoration: underline;
        cursor: pointer;
        text-align: left;
    }

    .fav-btn {
        width: 100%;
        margin-top: .6rem;
        background: #fff;
        border: 1px solid var(--line);
        color: var(--brown-dark);
        border-radius: var(--radius);
        padding: .45rem .8rem;
        font-size: .92rem;
        cursor: pointer;
        text-align: left;
    }
    .fav-btn:hover { border-color: var(--danger); }
    .fav-btn.on { border-color: var(--danger); color: var(--danger); font-weight: 600; }

    /* Yorumlar */
    .review-form textarea {
        width: 100%;
        min-height: 110px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: .7rem .8rem;
        font-size: .95rem;
        resize: vertical;
    }
    .review-form textarea:focus { outline: none; border-color: var(--green); }
    .review-actions { display: flex; gap: .6rem; align-items: center; margin-top: .5rem; }

    .review-btn {
        background: var(--action);
        color: #fff;
        border: 0;
        border-radius: var(--radius);
        padding: .45rem 1.2rem;
        font-size: .9rem;
        cursor: pointer;
    }
    .review-btn:hover { background: var(--action-dark); }

    .review-note { font-size: .92rem; color: var(--muted); }
    .review-note a { color: var(--green); }

    .review-list { margin-top: 1.5rem; }

    .review-item {
        border-top: 1px solid var(--line);
        padding: 1rem 0;
    }

    .review-head { display: flex; align-items: center; gap: .6rem; margin-bottom: .35rem; }
    .review-user { font-weight: 700; color: var(--brown-dark); }
    .review-you { font-size: .75rem; color: var(--green); border: 1px solid var(--line); border-radius: 999px; padding: 0 .5rem; }
    .review-stars { display: inline-flex; color: var(--star); }
    .review-stars .star { width: 15px; height: 15px; flex: 0 0 15px; }
    .review-stars .off { color: var(--star-off); }

    .review-tools { margin-left: auto; display: flex; gap: .8rem; }
    .review-tools button {
        background: none;
        border: 0;
        padding: 0;
        color: var(--green);
        font-size: .85rem;
        cursor: pointer;
    }
    .review-tools button:hover { text-decoration: underline; }
    .review-tools .danger { color: var(--danger); }

    .review-cancel {
        background: none;
        border: 0;
        color: var(--muted);
        font-size: .9rem;
        cursor: pointer;
    }
    .review-cancel:hover { text-decoration: underline; }

    .review-text {
        font-family: var(--font-serif);
        color: var(--text);
        line-height: 1.65;
        white-space: pre-line;
    }

    .review-like { display: flex; align-items: center; gap: .7rem; margin-top: .6rem; }

    .like-btn {
        background: #fff;
        border: 1px solid var(--line);
        color: var(--brown-dark);
        border-radius: 999px;
        padding: .2rem .9rem;
        font-size: .82rem;
        cursor: pointer;
    }
    .like-btn:hover { border-color: var(--green); }
    .like-btn.on { background: var(--brown-dark); border-color: var(--brown-dark); color: #fff; font-weight: 600; }

    .like-count { font-size: .82rem; color: var(--muted); }

    /* Yanıtlar */
    .reply-list {
        margin: .8rem 0 0 1.25rem;
        padding-left: 1rem;
        border-left: 2px solid var(--line);
    }

    .reply-item { padding: .5rem 0; }
    .reply-head { display: flex; align-items: center; gap: .6rem; }
    .reply-user { font-weight: 700; color: var(--brown-dark); font-size: .9rem; }
    .reply-date { font-size: .78rem; color: var(--muted); }

    .reply-delete {
        background: none;
        border: 0;
        padding: 0;
        color: var(--danger);
        font-size: .8rem;
        cursor: pointer;
    }
    .reply-delete:hover { text-decoration: underline; }

    .reply-text {
        font-family: var(--font-serif);
        color: var(--text);
        font-size: .95rem;
        line-height: 1.6;
        white-space: pre-line;
    }

    .reply-form { margin: .8rem 0 0 1.25rem; }
    .reply-form textarea {
        width: 100%;
        min-height: 70px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: .5rem .7rem;
        font-size: .9rem;
        resize: vertical;
    }
    .reply-form textarea:focus { outline: none; border-color: var(--green); }
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="star" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
    </symbol>
</svg>

<div class="details-page">

    <div class="details-breadcrumb">
        <a href="/">Home</a> &rsaquo; <span>@Model.Book.Title</span>
    </div>

    <div class="row g-5">

        <div class="col-md-4 text-center text-md-start">
            @if (!string.IsNullOrWhiteSpace(Model.Book.CoverImageUrl))
            {
                <img src="@Model.Book.CoverImageUrl" class="details-cover" alt="@Model.Book.Title" />
            }
            else
            {
                <div class="details-cover-empty">No cover</div>
            }

            <div class="rating-box">
                <div class="rating-avg">
                    <div class="stars-static">
                        @for (var s = 0; s < 5; s++)
                        {
                            <svg class="star"><use href="#star" /></svg>
                        }
                        <div class="fill" style="width:@(pct)%">
                            @for (var s = 0; s < 5; s++)
                            {
                                <svg class="star"><use href="#star" /></svg>
                            }
                        </div>
                    </div>
                    @if (Model.RatingCount > 0)
                    {
                        <span class="num">@Model.AverageRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    }
                </div>

                <div class="rating-summary">
                    @(Model.RatingCount == 0 ? "No ratings yet"
                        : Model.RatingCount == 1 ? "1 rating"
                        : $"{Model.RatingCount} ratings")
                </div>

                <div class="rate-title">
                    @(User.Identity?.IsAuthenticated == true ? "Rate this book" : "Want to rate this book?")
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page-handler="Rate" asp-route-id="@Model.Book.Id">
                        <div class="star-input">
                            @for (var i = 5; i >= 1; i--)
                            {
                                <button type="submit" name="rating" value="@i"
                                        class="@(Model.MyRating >= i ? "on" : "")"
                                        title="@(i == 1 ? "1 star" : $"{i} stars")">
                                    <svg class="star"><use href="#star" /></svg>
                                </button>
                            }
                        </div>
                    </form>
                }
                else
                {
                    <a class="rate-login" href="/Identity/Account/Login">Sign in</a>
                }
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="shelf-box">
                    <div class="rate-title">My Shelf</div>

                    <form method="post" asp-page-handler="Shelf" asp-route-id="@Model.Book.Id" class="shelf-buttons">
                        @foreach (var raf in Raflar.Hepsi)
                        {
                            <button type="submit" name="status" value="@raf.Kod"
                                    class="shelf-btn @(Model.MyShelf == raf.Kod ? "on" : "")">
                                @raf.Ad
                            </button>
                        }
                        @if (Model.MyShelf != null)
                        {
                            <button type="submit" name="status" value="remove" class="shelf-remove">Remove from shelf</button>
                        }
                    </form>

                    <form method="post" asp-page-handler="Favorite" asp-route-id="@Model.Book.Id">
                        <button type="submit" class="fav-btn @(Model.IsFavorite ? "on" : "")">
                            @(Model.IsFavorite ? "In Favorites" : "Add to Favorites")
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="col-md-8">
            <h1 class="details-title">@Model.Book.Title</h1>
            <div class="details-author">@Model.Book.Author</div>

            <div class="details-tags">
                <span class="details-tag">@(Model.Book.Category?.Name ?? "Uncategorized")</span>
                @if (Model.Book.PublishYear > 0)
                {
                    <span class="details-tag">@Model.Book.PublishYear</span>
                }
            </div>

            <h2 class="details-section-title">Description</h2>
            <div class="details-desc">@(string.IsNullOrWhiteSpace(Model.Book.Description)
                ? "No description has been added for this book yet."
                : Model.Book.Description)</div>

            <h2 class="details-section-title" id="reviews">Community Reviews</h2>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <p class="review-note"><a href="/Identity/Account/Login">Sign in</a> to write a review.</p>
            }
            else if (Model.MyRating == null)
            {
                <p class="review-note">Rate this book first to write a review.</p>
            }
            else
            {
                var yorumuVar = !string.IsNullOrEmpty(Model.MyComment);

                <form method="post" asp-page-handler="Review" asp-route-id="@Model.Book.Id"
                      class="review-form" id="review-form" style="@(yorumuVar ? "display:none" : "")">
                    <textarea name="comment" id="review-text" maxlength="@BookNest.Pages.Books.DetailsModel.YorumMaxUzunluk"
                              placeholder="What did you think of this book?">@Model.MyComment</textarea>
                    <div class="review-actions">
                        <button type="submit" class="review-btn">
                            @(yorumuVar ? "Save changes" : "Post review")
                        </button>
                        @if (yorumuVar)
                        {
                            <button type="button" class="review-cancel" onclick="yorumFormu(false)">Cancel</button>
                        }
                    </div>
                </form>
            }

            <div class="review-list">
                @if (!Model.Yorumlar.Any())
                {
                    <p class="review-note">No reviews yet. Be the first to share your thoughts.</p>
                }
                @foreach (var y in Model.Yorumlar)
                {
                    <div class="review-item" id="review-@y.Id">
                        <div class="review-head">
                            <span class="review-user">@y.KullaniciAdi</span>
                            @if (y.BenimMi)
                            {
                                <span class="review-you">You</span>
                            }
                            <span class="review-stars" title="@y.Puan of 5">
                                @for (var s = 1; s <= 5; s++)
                                {
                                    <svg class="star @(s <= y.Puan ? "" : "off")"><use href="#star" /></svg>
                                }
                            </span>
                            @if (y.BenimMi)
                            {
                                <div class="review-tools">
                                    <button type="button" onclick="yorumFormu(true)">Edit</button>
                                    <form method="post" asp-page-handler="DeleteReview" asp-route-id="@Model.Book.Id"
                                          onsubmit="return confirm('Delete your review?');">
                                        <button type="submit" class="danger">Delete</button>
                                    </form>
                                </div>
                            }
                        </div>
                        <div class="review-text">@y.Yorum</div>

                        <div class="review-like">
                            @if (User.Identity?.IsAuthenticated == true && !y.BenimMi)
                            {
                                <form method="post" asp-page-handler="Like" asp-route-id="@Model.Book.Id">
                                    <input type="hidden" name="reviewId" value="@y.Id" />
                                    <button type="submit" class="like-btn @(y.BenBegendim ? "on" : "")">
                                        @(y.BenBegendim ? "Liked" : "Like")
                                    </button>
                                </form>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <button type="button" class="like-btn" onclick="yanitFormu(@y.Id, true)">Reply</button>
                            }
                            @if (y.BegeniSayisi > 0)
                            {
                                <span class="like-count">@(y.BegeniSayisi == 1 ? "1 like" : $"{y.BegeniSayisi} likes")</span>
                            }
                            @if (y.Yanitlar.Count > 0)
                            {
                                <span class="like-count">@(y.Yanitlar.Count == 1 ? "1 reply" : $"{y.Yanitlar.Count} replies")</span>
                            }
                        </div>

                        @if (y.Yanitlar.Any())
                        {
                            <div class="reply-list">
                                @foreach (var yanit in y.Yanitlar)
                                {
                                    <div class="reply-item">
                                        <div class="reply-head">
                                            <span class="reply-user">@yanit.KullaniciAdi</span>
                                            <span class="reply-date">@yanit.Tarih.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                            @if (yanit.BenimMi)
                                            {
                                                <form method="post" asp-page-handler="DeleteReply" asp-route-id="@Model.Book.Id"
                                                      onsubmit="return confirm('Delete your reply?');" style="margin-left:auto">
                                                    <input type="hidden" name="replyId" value="@yanit.Id" />
                                                    <button type="submit" class="reply-delete">Delete</button>
                                                </form>
                                            }
                                        </div>
                                        <div class="reply-text">@yanit.Metin</div>
                                    </div>
                                }
                            </div>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page-handler="Reply" asp-route-id="@Model.Book.Id"
                                  class="reply-form" id="reply-form-@y.Id" style="display:none">
                                <input type="hidden" name="reviewId" value="@y.Id" />
                                <textarea name="replyText" maxlength="@BookNest.Pages.Books.DetailsModel.YanitMaxUzunluk"
                                          placeholder="Write a reply..."></textarea>
                                <div class="review-actions">
                                    <button type="submit" class="review-btn">Reply</button>
                                    <button type="button" class="review-cancel" onclick="yanitFormu(@y.Id, false)">Cancel</button>
                                </div>
                            </form>
                        }
                    </div>
                }
            </div>

            <a href="/" class="details-back">&larr; Back to Home</a>
        </div>

    </div>
</div>

<script>
    // Edit butonuna basınca yorum formunu açar, Cancel'a basınca kapatır
    function yorumFormu(ac) {
        var form = document.getElementById('review-form');
        if (!form) return;
        form.style.display = ac ? '' : 'none';
        if (ac) {
            var kutu = document.getElementById('review-text');
            kutu.focus();
            kutu.setSelectionRange(kutu.value.length, kutu.value.length);
            form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }

    // Reply butonuna basınca o yorumun yanıt kutusunu açar, Cancel'a basınca kapatır
    function yanitFormu(yorumId, ac) {
        var form = document.getElementById('reply-form-' + yorumId);
        if (!form) return;
        form.style.display = ac ? '' : 'none';
        if (ac) {
            var kutu = form.querySelector('textarea');
            kutu.focus();
            form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }
</script>