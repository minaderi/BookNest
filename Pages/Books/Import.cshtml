@page
@model BookNest.Pages.Books.ImportModel
@{
    ViewData["Title"] = "Add Book";
}

<style>
    .import-landing {
        min-height: 65vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .import-hero {
        text-align: center;
        padding: 1.5rem 0 1rem;
    }

    .import-hero h1 {
        color: var(--brown-dark);
        font-weight: 700;
    }

    .import-hero p {
        color: var(--soft);
        margin-bottom: 0;
    }

    .import-search {
        width: 100%;
        max-width: 640px;
        margin: 1.5rem auto 2rem;
    }

    .import-search .form-control {
        border-color: var(--line);
        padding: .8rem 1.1rem;
        border-radius: var(--radius) 0 0 var(--radius);
    }

    .import-search .form-control:focus {
        border-color: var(--green);
        box-shadow: 0 0 0 .2rem rgba(0, 99, 93, .15);
    }

    .import-search .btn {
        background: var(--action);
        color: #fff;
        border: 0;
        padding: .8rem 1.6rem;
        border-radius: 0 var(--radius) var(--radius) 0;
    }

    .import-search .btn:hover {
        background: var(--action-dark);
    }

    .import-card {
        display: flex;
        gap: 1.1rem;
        height: 100%;
        padding: 1.1rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        box-shadow: none;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .import-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(56, 33, 16, .10);
    }

    .import-cover {
        flex: 0 0 100px;
        width: 100px;
        height: 150px;
        border-radius: var(--radius);
        object-fit: cover;
        box-shadow: 0 3px 8px rgba(0, 0, 0, .2);
    }

    .import-cover-empty {
        flex: 0 0 100px;
        width: 100px;
        height: 150px;
        border-radius: var(--radius);
        background: var(--cream);
        border: 1px dashed var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-size: .8rem;
    }

    .import-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
    }

    .import-info h5 {
        color: var(--brown-dark);
        font-weight: 700;
        margin-bottom: .2rem;
    }

    .import-meta {
        color: var(--soft);
        font-size: .9rem;
        margin-bottom: .5rem;
    }

    .import-desc {
        font-size: .9rem;
        color: var(--soft);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: .75rem;
    }

    .import-tag {
        display: inline-block;
        background: var(--cream);
        color: var(--brown-dark);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .1rem .7rem;
        font-size: .78rem;
        margin-bottom: .6rem;
        align-self: flex-start;
    }

    .import-add {
        margin-top: auto;
        align-self: flex-start;
        background: var(--action);
        color: #fff;
        border: 0;
        border-radius: var(--radius);
        padding: .45rem 1.3rem;
        font-size: .9rem;
    }

    .import-add:hover {
        background: var(--action-dark);
        color: #fff;
    }

    .import-empty {
        text-align: center;
        color: var(--soft);
        padding: 2.5rem 0;
    }

    .import-empty .big {
        font-size: 3rem;
    }
</style>

<div class="import-page @(string.IsNullOrWhiteSpace(Model.Q) ? "import-landing" : "")">

    <div class="import-hero">
        <h1>Add Book</h1>
        <p>Search Google Books and add a book to the library.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success text-center mx-auto" style="max-width:640px;">
            @Model.Message
        </div>
    }

    <form method="get" class="import-search">
        <div class="input-group">
            <input type="text" name="Q" value="@Model.Q" class="form-control"
                   placeholder="Search by title or author..." autofocus />
            <button type="submit" class="btn">Search</button>
        </div>
    </form>

    @if (string.IsNullOrWhiteSpace(Model.Q))
    {
        <div class="import-empty">
            <p>Start by typing a book title or an author.</p>
        </div>
    }
    else if (!Model.Results.Any())
    {
        <div class="import-empty">
            <p>No results found for "@Model.Q". Try a different spelling.</p>
        </div>
    }
    else
    {
        <p class="text-muted mb-3">@(Model.Results.Count == 1 ? "1 result" : $"{Model.Results.Count} results") found</p>

        <div class="row row-cols-1 row-cols-lg-2 g-4">
            @foreach (var book in Model.Results)
            {
                <div class="col">
                    <div class="import-card">

                        @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                        {
                            <img class="import-cover" src="@book.CoverImageUrl" alt="@book.Title" />
                        }
                        else
                        {
                            <div class="import-cover-empty">No cover</div>
                        }

                        <div class="import-info">
                            <h5>@book.Title</h5>
                            <div class="import-meta">
                                @(string.IsNullOrWhiteSpace(book.Author) ? "Unknown author" : book.Author)
                                @(book.PublishYear > 0 ? $" · {book.PublishYear}" : "")
                            </div>

                            @if (!string.IsNullOrWhiteSpace(book.Category))
                            {
                                <span class="import-tag">@book.Category</span>
                            }

                            <div class="import-desc">
                                @(string.IsNullOrWhiteSpace(book.Description) ? "No description available." : book.Description)
                            </div>

                            <form method="post" asp-page-handler="Add">
                                <input type="hidden" name="title" value="@book.Title" />
                                <input type="hidden" name="author" value="@book.Author" />
                                <input type="hidden" name="description" value="@book.Description" />
                                <input type="hidden" name="coverImageUrl" value="@book.CoverImageUrl" />
                                <input type="hidden" name="publishYear" value="@book.PublishYear" />
                                <input type="hidden" name="category" value="@book.Category" />
                                <input type="hidden" name="Q" value="@Model.Q" />
                                <button type="submit" class="import-add">Add to Library</button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>