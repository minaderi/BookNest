@page
@model BookNest.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold" style="color: var(--brown-dark);">Welcome to BookNest</h1>
        <p class="lead text-muted">Organize your reading, discover new books and write reviews.</p>
    </div>

    <h2 class="mb-4 border-bottom pb-2">The Booker Prize 2026 Shortlist</h2>

    <div class="row row-cols-1 row-cols-md-4 g-4">
        @if (Model.Books != null && Model.Books.Count > 0)
        {
            @foreach (var book in Model.Books)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? "https://via.placeholder.com/150" : book.CoverImageUrl)" 
                             class="card-img-top" alt="@book.Title" style="height: 300px; object-fit: contain;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark">@book.Title</h5>
                            <p class="card-text text-muted mb-1">by @book.Author</p>
                            @if (book.Category != null)
                            {
                                <span class="bn-tag mb-3 align-self-start">@book.Category.Name</span>
                            }
                            <a asp-page="/Books/Details" asp-route-id="@book.Id"
   class="btn btn-outline-dark mt-auto btn-sm">
    View Details
</a>
                      </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No books have been added yet.</p>
            </div>
        }
    </div>
</div>